<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
      LiteRT 2.x is compiled with Kotlin 2.4 metadata, which this project's Kotlin
      compiler rejects ("incompatible version of Kotlin"). Stay on 1.4.x, which has
      the same Interpreter API, until the project's Kotlin version is raised.
    -->
    <issue id="GradleDependency">
        <ignore regexp="com\.google\.ai\.edge\.litert:litert" />
    </issue>
    <!--
      Android Studio 2026.2.1 supports the Android Gradle Plugin up to 9.4.0 and
      refuses to sync a project on a newer one. Stay on 9.4.0 until Studio is updated.
    -->
    <issue id="AndroidGradlePluginVersion">
        <ignore regexp="com\.android\.application" />
    </issue>
</lint>
