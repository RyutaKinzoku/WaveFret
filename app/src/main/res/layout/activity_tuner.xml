<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tunerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".tuner.TunerActivity">

    <include layout="@layout/include_top_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_l">

            <com.example.wavefret.tuner.TunerGaugeView
                android:id="@+id/tunerGaugeView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/space_l"
                />

            <TextView
                android:id="@+id/tunerStringNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:textAppearance="@style/TextAppearance.WaveFret.Display"
                android:textColor="?attr/colorOnSurface"
                tools:text="E" />

            <TextView
                android:id="@+id/tunerCentsOffsetTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.WaveFret.Title"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="+3¢" />

            <TextView
                android:id="@+id/tunerStatusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/tuner_listening_prompt"
                android:textAppearance="@style/TextAppearance.WaveFret.Body"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/tunerStringsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:contentDescription="@string/tuner_strings_description"
                android:orientation="horizontal" />

            <TextView
                style="@style/Widget.WaveFret.SecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/tuner_hint" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
