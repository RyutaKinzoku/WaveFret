<?xml version="1.0" encoding="utf-8"?>
<!-- Home: progress at a glance, tools, and the next exercise pinned in the thumb zone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/homeAppNameTextView"
                    style="@style/Widget.WaveFret.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/homeSettingsButton"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/settings_open_description"
                    app:icon="@drawable/ic_settings" />
            </LinearLayout>

            <TextView
                android:id="@+id/homeGreetingTextView"
                style="@style/Widget.WaveFret.SecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                tools:text="@string/home_greeting_new" />

            <TextView
                style="@style/Widget.WaveFret.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/home_progress_heading" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homeProgressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/homeStreakStat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/homeStreakValueTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="@dimen/space_xs"
                                android:gravity="center_vertical"
                                android:minHeight="24dp"
                                android:textAppearance="@style/TextAppearance.WaveFret.Title"
                                android:textColor="?attr/colorOnSurface"
                                app:drawableStartCompat="@drawable/ic_streak"
                                app:drawableTint="?attr/colorPrimary"
                                tools:text="3" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_stat_streak"
                                android:textAppearance="@style/TextAppearance.WaveFret.Label"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/homeWeekStat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/homeWeekValueTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="24dp"
                                android:textAppearance="@style/TextAppearance.WaveFret.Title"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="5" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_stat_week"
                                android:textAppearance="@style/TextAppearance.WaveFret.Label"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/homeMasteredStat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:focusable="true"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/homeMasteredValueTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="24dp"
                                android:textAppearance="@style/TextAppearance.WaveFret.Title"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="1/5" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_stat_mastered"
                                android:textAppearance="@style/TextAppearance.WaveFret.Label"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/homeMasteryProgressIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        app:indicatorColor="?attr/colorPrimary"
                        app:trackColor="?attr/colorSurfaceContainerHighest"
                        app:trackCornerRadius="4dp"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homeSongsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <TextView
                        style="@style/Widget.WaveFret.SectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:text="@string/home_songs_title"
                        app:drawableStartCompat="@drawable/ic_library_music"
                        app:drawableTint="?attr/colorPrimary" />

                    <TextView
                        style="@style/Widget.WaveFret.SecondaryText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/home_songs_body" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/homeAddSongButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_s"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/home_songs_add"
                            app:icon="@drawable/ic_add" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/homeOpenLibraryButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/home_songs_open_library"
                            app:icon="@drawable/ic_library_music" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.WaveFret.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/home_tools_heading" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/homeTunerCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/space_s"
                    android:layout_weight="1"
                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/space_s"
                            android:src="@drawable/ic_tuner"
                            app:tint="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:text="@string/home_tuner_title"
                            android:textAppearance="@style/TextAppearance.WaveFret.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/home_tuner_body"
                            android:textAppearance="@style/TextAppearance.WaveFret.Label"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/homeRecorderCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/space_s"
                            android:src="@drawable/ic_mic"
                            app:tint="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:text="@string/home_recorder_title"
                            android:textAppearance="@style/TextAppearance.WaveFret.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/home_recorder_body"
                            android:textAppearance="@style/TextAppearance.WaveFret.Label"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Thumb zone: the one thing to do next. -->
    <LinearLayout
        android:id="@+id/homeContinueContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_m">

        <TextView
            android:id="@+id/homeContinueLabelTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.WaveFret.Label"
            android:textColor="?attr/colorPrimary"
            tools:text="@string/home_continue_label" />

        <TextView
            android:id="@+id/homeContinueTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.WaveFret.Title"
            android:textColor="?attr/colorOnSurface"
            tools:text="Open strings" />

        <TextView
            android:id="@+id/homeContinueDetailTextView"
            style="@style/Widget.WaveFret.SecondaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="Beginner · 60 BPM · 8 notes" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homePracticeButton"
            style="@style/Widget.WaveFret.PrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            tools:text="Practise Open strings" />
    </LinearLayout>
</LinearLayout>
