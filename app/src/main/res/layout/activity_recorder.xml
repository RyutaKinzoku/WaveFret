<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recorderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".recording.RecorderActivity">

    <include layout="@layout/include_top_app_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_l">

        <TextView
            android:id="@+id/recorderTimerTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="none"
            android:text="@string/recorder_timer_zero"
            android:textAppearance="@style/TextAppearance.WaveFret.Display"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/recorderStatusTextView"
            style="@style/Widget.WaveFret.SecondaryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:accessibilityLiveRegion="polite"
            android:text="@string/recorder_status_idle" />
    </LinearLayout>

    <TextView
        style="@style/Widget.WaveFret.SectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_gutter"
        android:text="@string/recorder_takes_heading" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recorderTakesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_m" />

        <LinearLayout
            android:id="@+id/recorderEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_icon_badge"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_m"
                android:src="@drawable/ic_music_note"
                app:tint="?attr/colorOnPrimaryContainer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/recorder_empty_title"
                android:textAppearance="@style/TextAppearance.WaveFret.Body"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                style="@style/Widget.WaveFret.SecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/recorder_empty_body" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/recorderBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_m">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/recorderToggleButton"
            style="?attr/floatingActionButtonLargePrimaryStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/recorder_start_description"
            app:srcCompat="@drawable/ic_mic" />
    </FrameLayout>
</LinearLayout>
