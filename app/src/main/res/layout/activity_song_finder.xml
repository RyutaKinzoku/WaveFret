<?xml version="1.0" encoding="utf-8"?>
<!-- Song finder: search YouTube or tab sites inside WaveFret, then use the video or the tab on the page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/songFinderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".practice.songsearch.SongFinderActivity">

    <include layout="@layout/include_top_app_bar" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/songFinderKindToggleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_gutter"
        android:layout_marginBottom="@dimen/space_s"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/songFinderVideosButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/song_finder_videos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/songFinderTabsButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/song_finder_tabs" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/songFinderProgressIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible" />

    <WebView
        android:id="@+id/songFinderWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/songFinderBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingVertical="@dimen/space_m">

        <TextView
            android:id="@+id/songFinderHintTextView"
            style="@style/Widget.WaveFret.SecondaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            tools:text="@string/song_finder_tabs_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/songFinderUseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:minHeight="56dp"
            tools:text="@string/song_finder_use_tab" />
    </LinearLayout>
</LinearLayout>
