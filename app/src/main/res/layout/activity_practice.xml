<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/practiceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".practice.PracticeActivity">

    <include layout="@layout/include_top_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_l">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/practiceExerciseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/practiceExerciseTitleTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.WaveFret.Title"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="Open strings" />

                        <TextView
                            android:id="@+id/practiceExerciseDetailTextView"
                            style="@style/Widget.WaveFret.SecondaryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            tools:text="Beginner · 60 BPM · 8 notes · Best 85%" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand_more"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/practiceModeToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/practiceWaitModeButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/practice_mode_wait"
                    app:icon="@drawable/ic_hourglass" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/practiceTempoModeButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/practice_mode_tempo"
                    app:icon="@drawable/ic_metronome" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/practiceModeHelpTextView"
                style="@style/Widget.WaveFret.SecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/practice_mode_wait_help" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/practicePlayAlongButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:minHeight="@dimen/touch_target"
                android:text="@string/practice_play_along"
                android:visibility="gone"
                app:icon="@drawable/ic_play" />

            <TextView
                android:id="@+id/practiceCurrentNoteTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.WaveFret.Display"
                android:textColor="?attr/colorOnSurface"
                tools:text="A · fret 5" />

            <TextView
                android:id="@+id/practiceFeedbackTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/practice_feedback_ready"
                android:textAppearance="@style/TextAppearance.WaveFret.Body"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <com.example.wavefret.practice.TabStaffView
                    android:id="@+id/practiceTabStaffView"
                    android:layout_width="match_parent"
                    android:layout_height="176dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/practiceProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorSurfaceContainerHighest"
                app:trackCornerRadius="4dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="8dp" />

            <TextView
                android:id="@+id/practiceNoteProgressTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.WaveFret.Label"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Note 2 of 8" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/practiceBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingVertical="@dimen/space_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/practiceStartButton"
            style="@style/Widget.WaveFret.PrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/practice_start"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart" />
    </FrameLayout>
</LinearLayout>
