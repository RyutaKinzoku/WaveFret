<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: theme (system, light, dark) and in-app text size, with a live preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".settings.SettingsActivity">

    <include layout="@layout/include_top_app_bar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_l">

            <TextView
                style="@style/Widget.WaveFret.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:accessibilityHeading="true"
                android:text="@string/settings_theme_heading"
                tools:targetApi="28" />

            <RadioGroup
                android:id="@+id/settingsThemeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/settingsThemeSystemRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_theme_system" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/settingsThemeLightRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_theme_light" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/settingsThemeDarkRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_theme_dark" />
            </RadioGroup>

            <TextView
                style="@style/Widget.WaveFret.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:accessibilityHeading="true"
                android:text="@string/settings_text_size_heading"
                tools:targetApi="28" />

            <RadioGroup
                android:id="@+id/settingsTextSizeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/settingsTextSizeSmallRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_text_size_small" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/settingsTextSizeDefaultRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_text_size_default" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/settingsTextSizeLargeRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_text_size_large" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/settingsTextSizeExtraLargeRadioButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_text_size_extra_large" />
            </RadioGroup>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <TextView
                    android:id="@+id/settingsPreviewTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_l"
                    android:text="@string/settings_text_size_preview"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.WaveFret.SecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/settings_text_size_hint" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
