<?xml version="1.0" encoding="utf-8"?>
<!-- One string button: tap to tune it (or, if it is the chosen one, to go back to automatic). -->
<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.Button.TonalButton"
    android:layout_width="0dp"
    android:layout_height="72dp"
    android:layout_marginHorizontal="@dimen/space_xs"
    android:layout_weight="1"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:textAppearance="@style/TextAppearance.WaveFret.Title"
    app:iconGravity="textStart"
    app:iconPadding="@dimen/space_xs" />
